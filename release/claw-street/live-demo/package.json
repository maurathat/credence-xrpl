{
  "name": "claw-street-live-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Claw Street local signed-purchase demo and separate public browser simulation walkthrough",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "present": "node demo.mjs present",
    "rehearse": "node demo.mjs rehearse",
    "record": "node demo.mjs record",
    "check": "node demo.mjs check",
    "install-browser": "playwright install chromium",
    "selftest": "node guard-selftest.mjs",
    "local:check": "node local-demo.mjs check",
    "local:visible": "node local-demo.mjs check --headed",
    "local:present": "node local-demo.mjs present",
    "local:record": "node local-demo.mjs record"
  },
  "dependencies": {
    "playwright": "1.60.0"
  }
}
